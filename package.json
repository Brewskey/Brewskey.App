{
  "name": "brewskey.app-v3",
  "version": "3.0.1",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "build": "tsc --noEmit",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix --quiet",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "reset-project": "node ./scripts/reset-project.js",
    "expo-prebuild": "expo prebuild",
    "expo-prebuild:clean": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --go",
    "android:dev": "expo run:android --device",
    "deploy": "npx eas build --platform all --profile production --auto-submit --no-wait",
    "deploy:android": "npx eas build --platform android --profile production --auto-submit --no-wait",
    "deploy:ios": "npx eas build --platform ios --profile production --auto-submit --no-wait",
    "deploy:ota": "npx eas update --channel production",
    "deploy:ota:preview": "npx eas update --channel preview",
    "dev:android": "npx eas build --profile development --platform android --no-wait",
    "dev:ios": "npx eas build --profile development --platform ios --no-wait",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:expo": "concurrently \"npm run web\" \"wait-on http://localhost:8081 && playwright test\"",
    "test:e2e:expo:ui": "concurrently \"npm run web\" \"wait-on http://localhost:8081 && playwright test --ui\""
  },
  "dependencies": {
    "@brewskey/js-api": "^2.1.1",
    "@expo/metro-runtime": "~55.0.9",
    "@falcondev-oss/expo-event-source-polyfill": "^2.0.4",
    "@hookform/error-message": "^2.0.1",
    "@icedevml/react-native-host-card-emulation": "^0.8.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/material-top-tabs": "^7.4.23",
    "@react-navigation/native": "^7.1.33",
    "@rneui/base": "4.0.0-rc.8",
    "@rneui/themed": "4.0.0-rc.8",
    "@tanstack/react-query": "^5.99.1",
    "@teovilla/react-native-web-maps": "^0.9.5",
    "buffer": "^6.0.3",
    "expo": "~55.0.17",
    "expo-apple-authentication": "~55.0.13",
    "expo-application": "~55.0.14",
    "expo-auth-session": "~55.0.15",
    "expo-build-properties": "~55.0.13",
    "expo-constants": "~55.0.14",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "~55.0.28",
    "expo-device": "~55.0.15",
    "expo-image": "~55.0.9",
    "expo-image-picker": "~55.0.19",
    "expo-linking": "~55.0.14",
    "expo-location": "~55.1.8",
    "expo-notifications": "~55.0.20",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.14",
    "node-forge": "^1.4.0",
    "nullthrows": "^1.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.72.1",
    "react-native": "0.83.6",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.27.2",
    "react-native-nfc-manager": "^3.17.2",
    "react-native-pager-view": "8.0.0",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "react-native-worklets-core": "1.6.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/compat": "^2.0.5",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@types/node-forge": "^1.3.14",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-airbnb-extended": "3.0.1",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "@rneui/base": "4.0.0-rc.8",
    "@teovilla/react-native-web-maps": {
      "expo-location": "~55.1.8"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nfc-manager",
          "@icedevml/react-native-host-card-emulation",
          "react-native-vector-icons"
        ]
      }
    }
  },
  "private": true
}
