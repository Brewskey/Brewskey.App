{
  "name": "brewskey.app-v3",
  "version": "3.0.6",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "build": "tsc --noEmit",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix --quiet",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "reset-project": "node ./scripts/reset-project.js",
    "expo-prebuild": "expo prebuild",
    "expo-prebuild:clean": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --go",
    "android:dev": "expo run:android --device",
    "deploy": "npx eas build --platform all --profile production --auto-submit --no-wait",
    "deploy:android": "npx eas build --platform android --profile production --auto-submit --no-wait",
    "deploy:ios": "npx eas build --platform ios --profile production --auto-submit --no-wait",
    "deploy:ota": "npx eas update --channel production",
    "deploy:ota:preview": "npx eas update --channel preview",
    "dev:android": "npx eas build --profile development --platform android --no-wait",
    "dev:ios": "npx eas build --profile development --platform ios --no-wait",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:expo": "concurrently \"npm run web\" \"wait-on http://localhost:8081 && playwright test\"",
    "test:e2e:expo:ui": "concurrently \"npm run web\" \"wait-on http://localhost:8081 && playwright test --ui\"",
    "e2e-stack:up": "docker compose -f tests/e2e-stack/docker-compose.yml up -d --wait",
    "e2e-stack:down": "docker compose -f tests/e2e-stack/docker-compose.yml down",
    "test:e2e:real": "cross-env REAL_API=1 playwright test",
    "test:e2e:real:ui": "cross-env REAL_API=1 playwright test --ui"
  },
  "dependencies": {
    "@brewskey/js-api": "^2.1.4",
    "@expo/metro-runtime": "~57.0.3",
    "@falcondev-oss/expo-event-source-polyfill": "^2.0.4",
    "@hookform/error-message": "^2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-vector-icons/fontawesome": "^13.1.2",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "@react-native-vector-icons/material-icons": "^13.1.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/material-top-tabs": "^7.4.23",
    "@react-navigation/native": "^7.1.33",
    "@rneui/base": "^5.0.0",
    "@rneui/themed": "^5.0.0",
    "@tanstack/react-query": "^5.99.1",
    "@teovilla/react-native-web-maps": "^0.9.5",
    "buffer": "^6.0.3",
    "expo": "~57.0.2",
    "expo-apple-authentication": "~57.0.0",
    "expo-application": "~57.0.0",
    "expo-auth-session": "~57.0.1",
    "expo-build-properties": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.5",
    "expo-device": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.1",
    "expo-location": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-updates": "~57.0.6",
    "expo-web-browser": "~57.0.0",
    "node-forge": "^1.4.0",
    "nullthrows": "^1.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.72.1",
    "react-native": "^0.86.0",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.27.2",
    "react-native-nfc-manager": "^3.17.2",
    "react-native-pager-view": "8.0.2",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0",
    "react-native-worklets-core": "1.6.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/compat": "^2.0.5",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@types/node-forge": "^1.3.14",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-airbnb-extended": "3.0.1",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "@teovilla/react-native-web-maps": {
      "expo-location": "^57.0.2"
    },
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nfc-manager"
        ]
      }
    }
  },
  "private": true
}
